generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  STAFF
  ADMIN
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  phone    String?
  role     Role    @default(CITIZEN)
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  complaintsCreated  Complaint[] @relation("CitizenComplaints")
  complaintsAssigned Complaint[] @relation("StaffComplaints")

  @@index([role])
}

model Department {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  categories Category[]
  complaints Complaint[]
}

model Category {
  id       String @id @default(uuid())
  name     String
  slaHours Int    @default(72)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  complaints Complaint[]

  @@index([departmentId])
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Complaint {
  id          String            @id @default(uuid())
  title       String
  description String
  status      ComplaintStatus   @default(SUBMITTED)
  priority    ComplaintPriority @default(MEDIUM)

  citizenId String
  citizen   User   @relation("CitizenComplaints", fields: [citizenId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("StaffComplaints", fields: [assignedToId], references: [id])

  address   String
  latitude  Float?
  longitude Float?

  slaDueAt   DateTime?
  resolvedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([citizenId])
  @@index([departmentId])
  @@index([assignedToId])
}
